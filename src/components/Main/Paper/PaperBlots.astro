const chosenBlot = blots[Astro.props.blot-1]
const mult = 1/9.53;
let width = Astro.props.width; if (!width) width = chosenBlot.width;
let height = Astro.props.height; if (!height) height = chosenBlot.height;
width *= mult;
height *= mult;
const x = Astro.props.x * mult;
const y = Astro.props.y * mult;
const r = Astro.props.r * mult;
const a = Astro.props.a;
const color = Astro.props.color;

let offset = Astro.props.r_ ? -width : 0;
const styles = {
    width: `${width}vmin`,
    height: `${height}vmin`,
    transform: `translate(${x + offset}vmin, ${-y}vh) rotate(${r}deg)`,
    opacity: `${a}%`,
    backgroundColor: `${color}`,
    "--mask-image": `url(${chosenBlot.src})`
}
---

<div class="blot-parent"> 
    <div class="blot" style={styles}/>
</div>
<style>
    .blot-parent {
        width: 0;
        height: 0;
    }
    .blot {
        mask-image: var(--mask-image);
        mask-repeat: no-repeat; 
        mask-size: 100% 100%;  
        mask-position: center;
        objectFit: "none";

        -webkit-mask-image: var(--mask-image);
        -webkit-mask-repeat: no-repeat;
        -webkit-mask-size: 100% 100%;
    }
</style>