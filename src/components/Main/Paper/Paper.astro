---
import { Image } from "astro:assets";
import PaperTrans from "@assets/paper-trans.png"
import PaperContent from "./PaperContent.astro";
import PaperBlots from "./PaperBlots.astro";
---

<div class="paper-container"> 
    <div class="paper-background-rendering">
        <div class="paper-background">
            <Image src={PaperTrans} quality={90} alt="Paper transition"/>
            <div class="background-solid">
                <div class="blot-container">
                    <div class="left-anchor">
                        <PaperBlots blot={2} x={-100} y={0} r={20} a={50} color="#ff7aac"/>
                    </div>
                    <div class="right-anchor">
                        <PaperBlots blot={52} x={0} y={0} r={0} a={50} color="#ff7aac" r_="y"/>
                    </div>
                </div>
                <PaperContent/>
            </div>
        </div>
    </div>
</div>

<style>
    .left-anchor, .right-anchor {
        color: black;
    }
    .left-anchor {
        width: 0;
        height: 0;
    }
    .right-anchor {
        width: 0;
        height: 0;
        transform-origin: top right;
    }
    .blot-container {
        width: 100%;
        height: 0;
        display: flex;
        justify-content: space-between;
    }
    .paper-container {
        width: 100%;
    }
    .paper-background {
        width: 100%;
        margin-top: -350px;
    }
    .paper-background img {
        width: 100vw;
        height: auto;
        display: block;
        user-drag: none;
        -webkit-user-drag: none;
        user-select: none;
        -moz-user-select: none;
        -webkit-user-select: none;
        -ms-user-select: none;
    }
    .paper-background-rendering{
        width: 100%;
    }
    .background-solid {
        width: 100vw;
        background-color: #f7eded;
        background-image: radial-gradient(circle, #d0cbcc 0%, #d0cbcc 5%, transparent 7%);
        background-size: calc(100vw/48) calc(100vw/48);
        margin-top: calc(-100vw/40);
        padding-bottom: 64px;
        z-index: 1;
        bottom: 0;
        top: 0;
    }
</style>
