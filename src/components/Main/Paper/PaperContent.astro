<style>
    .image-cycler img {
        grid-area: 1 / 1;
        width: 100%;
        height: auto;
    }
    .image-cycler {
        display: grid;
        width: 100%;
        place-items: center;
        height: auto;
        background-color: black;
        margin-top: 16px;
    }
    .flex {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px; 
        max-width: 1036px;
        flex-wrap: wrap;
        scrollbar-gutter: stable;
    }
    @media (max-width: 650px) {
        .flex {
            justify-content: center;
        }
        
    }
    .drawing-container, .motion-graphics-container {
        min-width: 300px;
        min-height: 300px;
        max-width: 500px;
        flex: 1 1 0;
    }
    .seperator {
        flex: 0 0 auto;
        width: 4px;
        height: 300px;
        background-color: black;
    }
    .mg-title, .d-title {
        font-size: 32px !important;
    }
    .paper-title, .mg-title, .d-title {
        font-size: 64px;
        font-weight: bolder;
        width: 100%;
        padding: 16px;
    }
    .d-title span {
        color: transparent;
        background-clip: text;
        background-image: linear-gradient(-45deg,#9a6cc6 0%, #3461c0 34%, #a26cb8 72%, #fb947e 100%);
    }
    .mg-title span {
        color: transparent;
        background-clip: text;
        background-image: linear-gradient(45deg,#9a6cc6 0%, #3461c0 34%, #a26cb8 72%, #fb947e 100%);
    }
    .paper-title span {
        position: relative;
        color: transparent;
        background-clip: text;
        background-image: linear-gradient(90deg,#9a6cc6 0%, #3461c0 34%, #a26cb8 72%, #fb947e 100%);
    }
    .paper-content {
        color: black;
        width: 100vw;
        padding: 16px;
        height: auto;
        display: flex;
        align-items: center;
        text-align: center;
        flex-direction: column;
        z-index: 50;
        position: relative;
    }

</style>