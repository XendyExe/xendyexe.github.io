---
---
<div class="paper-content">
    <div class="paper-title"><span>Arts !</span></div>
    <div class="flex">
        <div class="drawing-container">
            <div class="d-title"><span>Drawing</span></div>

        </div>
        <div class="seperator"/>
        <div class="motion-graphics-container">
            <div class="mg-title"><span>Motion Graphics</span></div>

        </div>
    </div>
</div>
<style>
    .flex {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px; 
        max-width: 1036px;
        flex-wrap: wrap;
        scrollbar-gutter: stable;
    }
    .drawing-container, .motion-graphics-container {
        min-width: 300px;
        min-height: 300px;
        max-width: 500px;
        flex: 1 1 0;
    }
    .seperator {
        flex: 0 0 auto;
        width: 4px;
        height: 300px;
        background-color: black;
    }
    .mg-title, .d-title {
        font-size: 32px !important;
    }
    .paper-title, .mg-title, .d-title {
        font-size: 64px;
        font-weight: bolder;
        width: 100%;
        padding: 16px;
    }
    .d-title span {
        color: transparent;
        background-clip: text;
        background-image: linear-gradient(-45deg,rgba(154, 108, 198, 1) 0%, rgba(52, 97, 192, 1) 34%, rgba(162, 108, 184, 1) 72%, rgba(251, 148, 126, 1) 100%);
    }
    .mg-title span {
        color: transparent;
        background-clip: text;
        background-image: linear-gradient(45deg,rgba(154, 108, 198, 1) 0%, rgba(52, 97, 192, 1) 34%, rgba(162, 108, 184, 1) 72%, rgba(251, 148, 126, 1) 100%);
    }
    .paper-title span {
        color: transparent;
        background-clip: text;
        background-image: linear-gradient(90deg,rgba(154, 108, 198, 1) 0%, rgba(52, 97, 192, 1) 34%, rgba(162, 108, 184, 1) 72%, rgba(251, 148, 126, 1) 100%);
    }
    .paper-content {
        color: black;
        width: 100vw;
        padding: 16px;
        height: auto;
        display: flex;
        align-items: center;
        text-align: center;
        flex-direction: column;
        z-index: 5;
        position: relative;
    }

</style>