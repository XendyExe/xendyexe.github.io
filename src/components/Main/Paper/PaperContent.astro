---
import { Image } from "astro:assets";
import art from "@assets/art/fomx.png";
---
<div class="paper-content" id="arts">
    <div class="paper-title"><span>Arts !</span></div>
    <div class="flex">
        <div class="drawing-container">
            <div class="d-title"><span>Drawing</span></div>
            <div class="d-description">
                I draw sometimes using photoshop and ibis (on phone). Mostly anthro ocs/sonas !
            </div>
            <div class="image-cycler" id="image-cycler">
                <Image src={art} alt="fomx"/>
                <Image src={art} alt="fomx"/>
            </div>
            <div class="cycler-tooltip">(Click to cycle)</div>
        </div>
        <div class="motion-graphics-container">
            <div class="mg-title"><span>Motion Graphics</span></div>
            <div class="mg-description">
                I also do motion graphics sometimes in after effects, along with editing in premiere pro.
            </div>
        </div>
    </div>
</div>

