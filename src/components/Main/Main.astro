---
import Background from "./Background/Background.astro";
import SplashComponent from "./Splash/SplashComponent.astro";
import BackgroundCloud from "./Background/BackgroundCloud.astro";
import Postcard from "./Postcard/Postcard.astro";
import Paper from "./Paper/Paper.astro";
import Music from "./Music/Music.astro";
---

<div class="main">
    <Background />
    <main>
        <SplashComponent/>
        <div class="firefox-warning">
            <div class="firefox-title">Unsupported browser</div>
            <div class="firefox-subtitle">Best experianced with a Chromium based browser</div>
            <div class="firefox-subtitle">Your browser is missing scroll() css animations</div>
        </div>
        <Postcard />
        <!-- todo: music thing -->
        <Music/>
        <!-- todo: Coding thing -->
        <div id="programmings" style="width:100vw;height:100svh;border:2px pink solid;"></div>
        <Paper/>
    </div>
    <footer>

    </footer>
</div>
<style> 
    main {
        overflow: hidden;
    }
    footer {
        height: 256px;
        width: 100%;
        overflow: hidden;
        background-color: black;
        margin-top: calc(-100vw/120);
    }
    .firefox-warning {
        width: 100vw;
        min-height: 10svh;
        background-color: red;
        display: none;
        align-items: center;
        color: black;
        flex-direction: column;
        padding: 8px;
    }
    .firefox-subtitle {
        text-align: center;
    }
    .firefox-title {
        font-size: 32px;
    }
    @supports not (animation-timeline: scroll()) {
        .firefox-warning {
            display: flex;
        }
	}
</style>

<style is:global>
    @keyframes xendy-parallax-keyframes {
        from {
            transform: translateY(0);
        }
        to {
            transform: translateY(var(--xendy-parallax, 0));
        }
    }
    .xendy-parallax {
        animation: xendy-parallax-keyframes linear;
        animation-timeline: scroll();
        animation-fill-mode: both;
    }
    
	@supports (-moz-appearance: none) {
        .xendy-parallax {
            animation: none;
        }
	}
    .debug {
    }
    .footer {
        height: 30svh;
        bottom: 0;
        width: 100%;
        background-color: #000000;
        z-index: 0;
    }
    * {
        box-sizing: border-box;
    }
    .main {
        color: white;
    }
    
    @keyframes fadein {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
</style>
